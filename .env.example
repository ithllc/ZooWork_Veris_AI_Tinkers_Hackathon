# Required for live audits. Never put provider keys in browser/client config.
ZOOWORK_API_KEY=
# Optional fashion product-market enrichment; separate ZooData account/key.
ZOODATA_API_KEY=
ZOOWORK_MODEL=litellm/claude-haiku-5-5
PORT=3000
PUBLIC_URL=http://localhost:3000
# Set a long random stable secret in hosted environments.
ACCESS_TOKEN_SECRET=
DEMO_DAILY_LIMIT=30
# Deployment administration only; not needed by the web application.
RENDER_API_KEY=

# Optional accounts, inbox and browser push (required for messaging).
DATABASE_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://revampai-3ms5.onrender.com
